mutate(vax_rate_q = ntile(vax_rate, 4),
vax_rate_q = factor(vax_rate_q,
labels = c("Q1", "Q2", "Q3", "Q4")))
ggplot(aug_mod1) +
geom_point( aes(x = cell_phones_100,
y = life_exp,
color = vax_rate)) +
geom_smooth( aes(x = cell_phones_100,
y = .fitted,
color = vax_rate),
method = "lm", se=F) +
labs(title = "Life expectancy vs. cell phones with fitted regression lines",
