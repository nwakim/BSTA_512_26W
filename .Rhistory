geom_point(size=2) +
labs(x = "Number of cell phones per 100 people",
y = "Life expectancy (years)",
title = "Life expectancy vs. cell phones") +
geom_smooth(method = "lm", se = TRUE, size =3, color = "#F14124") +
geom_vline(xintercept = 60, color = "#A7EA52", size = 3) +
