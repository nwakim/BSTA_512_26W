library(tidyverse)
library(openintro)
library(janitor)
library(rstatix)
library(knitr)
library(gtsummary)
library(moderndive)
library(gt)
library(broom)
library(here)
library(pwr)
library(gridExtra) # NEW!!!
library(readxl)
# set ggplot theme for slides
theme_set(theme_bw(base_size = 22))
# theme_update(text = element_text(size=16))  # set global text size for ggplots
load(here("data", "gapminder2022.RData"))
gapm_slr_plot = gapm %>%
ggplot(aes(x = cell_phones_100,
y = life_exp)) +
geom_point(size = 4) +
geom_smooth(method = "lm", se = FALSE, size = 3, colour="#F14124") +
labs(x = "Cell phones per 100 people",
y = "Life expectancy (years)",
title = "Relationship between life expectancy and cell phones") +
theme(axis.title = element_text(size = 27),
axis.text = element_text(size = 25),
title = element_text(size = 25))
gapm_slr_plot
model1 <- gapm %>% lm(formula = life_exp ~ cell_phones_100)
tidy_model1 = tidy(model1)
tidy_model1
tidy_model1$estimate[1]
tidy_model1$estimate[1] %>% round(digits=2)
