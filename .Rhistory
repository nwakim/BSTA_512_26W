labs(x = "Theoretical quantiles", y = "Data quantiles")+
theme(axis.title = element_text(size = 8),
axis.text = element_text(size = 8))
mod_nt_resid = ggplot(mod_nt, aes(x = x, y = .resid)) +
geom_point(size=0.6) +
geom_abline( intercept = 0, slope = 0, color = "#FF8021") +
labs(y = "Residuals") +
theme(axis.title = element_text(size = 8),
axis.text = element_text(size = 8))
grid.arrange(mod_nt_qq, mod_nt_resid, nrow=1)
