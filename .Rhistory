sbp = read_csv("systolic1.csv")
#| echo: false
set.seed(464)
x = runif(n=200, min = 40, max = 80) - 60
z = sample(c("Light", "Moderate", "Vigorous"), size=200, replace = T)
y = rnorm(n=200, 130 - 0.8*x + 25*(z == "Moderate") + 50*(z == "Vigorous") -
1*(z == "Moderate")*x - 1.2*(z == "Vigorous")*x, 13)
y2 = rnorm(n=200, 130 - 0.86*x + 30*(z == "Moderate") + 75*(z == "Vigorous"), 13)
df = data.frame(Age_c = x, PAL = z, HR = y2)
df2 = data.frame(Age_c = x, PAL = z, HR = y)
#ggplot(df) + geom_point(aes(x=Age, y = HR, color = PAL))
#| echo: false
#| fig-align: center
#| warning: false
model1 = lm(HR ~ Age_c, data = df)
model2 = lm(HR ~ PAL, data = df)
model3 = lm(HR ~ Age_c + PAL, data = df)
model4 = lm(HR ~ Age_c + PAL + Age_c*PAL, data = df2)
#| echo: false
#| message: false
#|
