if(!require(lubridate)) { install.packages("lubridate"); library(lubridate) }
if(!require(sjPlot)) { install.packages("sjPlot"); library(sjPlot) }
if(!require(sjlabelled)) { install.packages("sjlabelled"); library(sjlabelled) }
if(!require(sjmisc)) { install.packages("sjmisc"); library(sjmisc) }
# Chunk 2
#| echo: false
load(here("../Project/data/iat_2024_comp_clean_factor_2026-02-19.rda"))
iat = iat_2024_comp_factor %>% filter(age > 18)
# Chunk 3
#| fig-width: 6
#| fig-height: 4
#| fig-align: center
#| warning: false
ggplot(data = iat, aes(x = age, y = iat_score)) +
geom_point(size = 0.8) + geom_smooth() + xlim(0, 111)
# Chunk 4
iat1 = iat %>% mutate(ind_age_100 = ifelse(age > 100, "TRUE", "FALSE"))
# Chunk 5
#| warning: false
ggplot(iat1, aes(x = age, y = iat_score, color = ind_age_100)) +
geom_point(size = 0.8) + geom_smooth(method = "lm")
# Chunk 6
prelim_model = iat1 %>%
lm(
formula = iat_score ~
iam_f +
re_asian + re_black + re_hispanic + re_me +
re_native + re_other + re_pacific + re_white +
gender_f +
trans_f +
pol_id_f +
control_other_f +
edu_f +
age
)
# Chunk 7
prelim_model$coefficients[2:7] # by using c(2:6, 46) I am telling R to
# Chunk 8
prelim_model2 = iat1 %>%
lm(
formula = iat_score ~
iam_f +
re_asian + re_black + re_hispanic + re_me +
re_native + re_other + re_pacific + re_white +
gender_f +
trans_f +
pol_id_f +
control_other_f +
edu_f +
age +
ind_age_100
)
prelim_model2$coefficients[2:7] # by using c(2:6, 46) I am telling R to
# only print certain variables' coefficients
?geom_smooth
ggplot() +
geom_point(iat1, aes(x = age, y = IAT_score)) +
geom_smooth(iat1, aes(x = age, y = iat_score), method = "lm") +
geom_smooth(iat1 %>% filter(age < 100), aes(x = age, y = iat_score), method = "lm")
ggplot() +
geom_point(iat1, aes(x = age, y = iat_score)) +
geom_smooth(iat1, aes(x = age, y = iat_score), method = "lm") +
geom_smooth(iat1 %>% filter(age < 100), aes(x = age, y = iat_score), method = "lm")
ggplot() +
geom_point(data = iat1, aes(x = age, y = iat_score)) +
geom_smooth(iat1, aes(x = age, y = iat_score), method = "lm") +
geom_smooth(iat1 %>% filter(age < 100), aes(x = age, y = iat_score), method = "lm")
ggplot() +
geom_point(data = iat1, aes(x = age, y = iat_score))
ggplot() +
geom_point(data = iat1, aes(x = age, y = iat_score)) +
geom_smooth(iat1, aes(x = age, y = iat_score), method = "lm")
ggplot() +
geom_point(data = iat1, aes(x = age, y = iat_score)) +
geom_smooth(data = iat1, aes(x = age, y = iat_score), method = "lm") +
geom_smooth(data = iat1 %>% filter(age < 100), aes(x = age, y = iat_score), method = "lm")
ggplot() +
geom_point(data = iat1, aes(x = age, y = iat_score)) +
geom_smooth(data = iat1, aes(x = age, y = iat_score), method = "lm", color = "red") +
geom_smooth(data = iat1 %>% filter(age < 100), aes(x = age, y = iat_score), method = "lm", color = "blue")
tidy_and_attach(prelim_model, conf.int=T) %>%
tidy_remove_intercept() %>%
tidy_add_reference_rows() %>% tidy_add_estimate_to_reference_rows() %>%
tidy_add_term_labels()
#| fig-height: 9
#| fig-width: 5
#| fig-align: center
library(broom.helpers)
tidy_and_attach(prelim_model, conf.int=T) %>%
tidy_remove_intercept() %>%
tidy_add_reference_rows() %>% tidy_add_estimate_to_reference_rows() %>%
tidy_add_term_labels()
ggplot(data=model_tidy, aes(y=label, x=estimate, xmin=conf.low, xmax=conf.high))
model_tidy = tidy_and_attach(prelim_model, conf.int=T) %>%
tidy_remove_intercept() %>%
tidy_add_reference_rows() %>%
tidy_add_estimate_to_reference_rows() %>%
tidy_add_term_labels()
forest_plot = ggplot(data=model_tidy, aes(y=label, x=estimate, xmin=conf.low, xmax=conf.high)) +
facet_grid(rows = vars(var_label), scales = "free",
space='free_y', switch = "y") +
geom_point(size = 3) +  geom_errorbarh(height=.2) +
geom_vline(xintercept=0, color='#C2352F', linetype='dashed', alpha=1) +
theme_classic() +
labs(x = "Beta", y = "Variables") +
theme(axis.title = element_text(size = 20), axis.text = element_text(size = 20),
title = element_text(size = 20), strip.placement = "outside",
strip.text.y.left = element_text(size = 18, angle = 0),
strip.background = element_blank())
forest_plot
