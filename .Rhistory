#| echo: false
Xstar <- 60
Y60 <- tidy(model1)$estimate[1] + tidy(model1)$estimate[2]*60
tstar <- qt(.975, df = n - 2)
s_resid <- glance(model1)$sigma
n <- nobs(model1)
mx <- mean(gapm$cell_phones_100, na.rm=T)
s_x <- sd(gapm$cell_phones_100, na.rm=T)
SE_Yx <- s_resid *sqrt(1/n + (Xstar - mx)^2/((n-1)*s_x^2))
MOE_Yx <- SE_Yx*tstar
LCI = Y60 - MOE_Yx
UCI = Y60 + MOE_Yx
