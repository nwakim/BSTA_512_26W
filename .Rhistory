set.seed(2212026)
df = data.frame(x = runif(110, 1, 20)) %>%
mutate(y = rnorm(log((1/4)*x), 4),
logx = log(x))
#ggplot(df, aes(x = x, y=y)) + geom_point()
mod_nt = lm(y~x, data=df) %>% augment()
mod_lty = lm(log(y)~x, data=df) %>% augment()
mod_ltx = lm(y~logx, data=df) %>% augment()
mod_sry = lm(sqrt(y)~x, data=df) %>% augment()
#| echo: false
#| fig-height: 1.44
#| fig-width: 4
