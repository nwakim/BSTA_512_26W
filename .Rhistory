# Chunk 15
# Fit regression model:
mr1 <- gapm %>%
lm(formula = life_exp ~ cell_phones_100 + vax_rate)
tidy(mr1, conf.int=T) %>% gt() %>% tab_options(table.font.size = 35) %>% fmt_number(decimals = 3)
# Chunk 16
#| echo: false
mr1_tidy = tidy(mr1, conf.int=T)
# Chunk 17
#| fig-align: center
# setup hideous grid required by plotly
mr1 <- gapm %>%
lm(formula = life_exp ~ cell_phones_100 + vax_rate)
x_grid <- seq(from = min(gapm$cell_phones_100, na.rm = TRUE),
to = max(gapm$cell_phones_100, na.rm = TRUE),
length = 100)
y_grid <- seq(from = min(gapm$vax_rate, na.rm = TRUE),
to = max(gapm$vax_rate, na.rm = TRUE),
length = 200)
z_grid <- expand.grid(x_grid, y_grid) %>%
as_tibble() %>%
rename(x_grid = Var1, y_grid = Var2) %>%
mutate(z = coef(mr1)[1] + coef(mr1)[2]*x_grid + coef(mr1)[3]*y_grid) %>%
.[["z"]] %>%
matrix(nrow=length(x_grid)) %>%
t()
# Plot points
plot_ly() %>%
add_markers(
x = gapm$cell_phones_100,
y = gapm$vax_rate,
z = gapm$life_exp,
hoverinfo = 'text',
text = ~paste("x1 - Cell phones per 100 people: ",
gapm$cell_phones_100,
"</br> x2 - Vaccination rate (%): ",
gapm$basic_sani,
"</br> y - Life expectancy: ",
gapm$life_exp)
) %>%
# Label axes
layout(
scene = list(
xaxis = list(title = "x1 - Cell phones per 100 people"),
yaxis = list(title = "x2 - Vaccination rate (%)"),
zaxis = list(title = "y - Life expectancy")
)
) %>%
# Add regression plane
add_surface(
x = x_grid,
y = y_grid,
z = z_grid
)
