library(tidyverse)
library(janitor)
library(knitr)
library(broom)
library(rstatix)
library(gt)
library(readxl)
#----------
# new packages
# install.packages("describedata")
library(describedata) # gladder()
library(gridExtra)   # grid.arrange()
library(ggfortify)  # autoplot(model)
# New Day 6
library(gtsummary)
# New Day 7
library(plotly) # for plot_ly() command
library(GGally) # for ggpairs() command
library(ggiraphExtra)   # for ggPredict() command
knitr::opts_chunk$set(echo = TRUE, fig.height=6, fig.width=8,
message = FALSE, warning = FALSE)
theme_set(theme_bw(base_size = 12))
# Chunk 3
# Load the data - update code if the file is not in the same location
# on your computer
load(here("data", "gapminder2022.RData"))
gapm = gapm %>%
mutate(fs_order = case_when(freedom_status == "F" ~ 3,
freedom_status == "PF" ~ 2,
freedom_status == "NF" ~ 1),
freedom_status = fct_relevel(freedom_status, "NF", "PF", "F")) %>%
mutate(income_level_4 = fct_relevel(income_level_4,
"Low income",
"Lower middle income",
"Upper middle income",
"High income"))
glimpse(gapm)
# Chunk 4
#| echo: false
#| fig-width: 14
#| fig-height: 5
#| code-fold: true
#| code-summary: "Code: Create three SLR plots for life expectancy vs. cell phones, income level, and basic sanitation"
gapm_slr_plot = gapm %>%
ggplot(aes(x = cell_phones_100,
y = life_exp)) +
geom_point(size = 2) +
geom_smooth(method = "lm", se = FALSE, size = 2, colour="#F14124") +
geom_smooth(method = "loess", se = FALSE, size = 2, colour="#34AC8B") +
labs(x = "Cell phones per 100 people",
y = "Life expectancy (years)") +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 15))
slr_income_plot = ggplot(gapm, aes(x = income_level_4, y = life_exp)) +
geom_jitter(size = 1, alpha = .6, width = 0.2) +
stat_summary(fun = mean, geom = "point", size = 8, shape = 18) +
scale_x_discrete(limits = levels(gapm$income_level_4), labels = function(x) str_wrap(x, width=9)) +
labs(x = "Income levels",
y = "Life expectancy (years)") +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 15))
gapm_bs_plot = gapm %>%
ggplot(aes(x = vax_rate,
y = life_exp)) +
geom_point(size = 2) +
geom_smooth(method = "lm", se = FALSE, size = 2, colour="#F14124") +
geom_smooth(method = "loess", se = FALSE, size = 2, colour="#34AC8B") +
labs(x = "Vaccination rate (%)",
y = "Life expectancy (years)") +
theme(axis.title = element_text(size = 15),
axis.text = element_text(size = 15))
grid.arrange(gapm_slr_plot, slr_income_plot, gapm_bs_plot, nrow = 1)
# Chunk 5
#| echo: false
#| code-fold: true
ggplot(gapm, aes(x = cell_phones_100,
y = life_exp,
color = income_level_4)) +
geom_point() +
geom_smooth(method = "lm", se=F) +
labs(title = "Life expectancy vs. cell phones",
x = "Cell phones per 100 people",
y = "Life Expectancy (yrs)",
color = "Income level") +
theme(axis.title = element_text(size = 10),
axis.text = element_text(size = 10),
title = element_text(size = 10))
# Chunk 6
#| code-fold: true
#| code-summary: "Code: Use lm() to fit model and then tidy() to display regression table"
mr1 <- gapm %>% lm(formula = life_exp ~ cell_phones_100 + income_level_4)
tidy(mr1, conf.int=T) %>% gt() %>% tab_options(table.font.size = 35) %>% fmt_number(decimals = 3)
